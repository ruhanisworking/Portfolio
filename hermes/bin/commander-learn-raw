#!/opt/hermes/.venv/bin/python3
"""Raw material for the daily Learn job: new rising GitHub repos, Hacker News top
stories, and the topics already covered, printed as plain text. The Hermes cron
job injects this output into its prompt and writes learn.json from it.
No API keys: GitHub search (unauthenticated) and the public HN API.
"""
import datetime as dt
import json
import urllib.request

UA = {"User-Agent": "ruhan-commander-learn"}
LEARN = "/opt/data/commander/data/learn.json"


def get(url):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=30) as r:
        return json.load(r)


def main():
    week = (dt.date.today() - dt.timedelta(days=7)).isoformat()
    print(f"# Learn raw material, {dt.date.today()}\n")
    print("## GitHub: repos created in the last 7 days, most stars")
    try:
        q = f"https://api.github.com/search/repositories?q=created:>{week}&sort=stars&order=desc&per_page=12"
        for r in get(q).get("items", []):
            desc = (r.get("description") or "").replace("\n", " ")[:160]
            print(f"- {r['full_name']} ★{r['stargazers_count']} [{r.get('language') or '-'}] {desc} — {r['html_url']}")
    except Exception as e:
        print(f"! GitHub failed: {e}")

    print("\n## Hacker News: top stories now")
    try:
        for i in get("https://hacker-news.firebaseio.com/v0/topstories.json")[:15]:
            s = get(f"https://hacker-news.firebaseio.com/v0/item/{i}.json") or {}
            url = s.get("url") or f"https://news.ycombinator.com/item?id={i}"
            print(f"- {s.get('title')} ({s.get('score', 0)} points) — {url}")
    except Exception as e:
        print(f"! Hacker News failed: {e}")

    print("\n## Already covered (do not repeat these topics)")
    try:
        recs = json.load(open(LEARN, encoding="utf-8")).get("records", [])
        for r in recs[-60:]:
            print(f"- {r.get('date', '')} {r.get('topic', '')}")
        if not recs:
            print("- (none yet)")
    except FileNotFoundError:
        print("- (none yet)")


if __name__ == "__main__":
    main()
