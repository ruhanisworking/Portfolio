# Commander (ruhan.lol). Login: server-side basic auth, same user/password as
# the Hermes dashboard (bcrypt hash in commander-auth.caddy, from dashboard.env;
# never committed). Covers every path, /data/ included.
:80 {
	import /etc/caddy/commander-auth.caddy
	handle_path /data/* {
		root * /srv/data
		header Cache-Control "no-store"
		file_server
	}
	handle {
		root * /srv/site
		file_server
	}
}
