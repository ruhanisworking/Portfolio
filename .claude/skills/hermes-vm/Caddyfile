# Commander (ruhan.lol). Cloudflare Access sits in front; on top of that the
# same user/password as the Hermes dashboard (bcrypt hash in commander-auth.caddy,
# generated from dashboard.env — never committed).
:80 {
	import /etc/caddy/commander-auth.caddy
	handle_path /data/* {
		root * /srv/data
		header Cache-Control "no-store"
		file_server
	}
	handle {
		root * /srv/site
		file_server
	}
}
